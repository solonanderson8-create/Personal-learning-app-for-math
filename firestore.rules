// Firestore rules. These live in the Firebase console; this file is a copy for reference.
// Replace YOUR_UID with the User UID shown in Firebase console > Authentication > Users.
// Only that one account can read or write anything. Everyone else is refused.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && uid == 'YOUR_UID';
    }
  }
}
